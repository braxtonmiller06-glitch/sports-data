# Same Supabase project atlas/ uses -- anon/public key only (this runs in
# the browser). Never put the service-role key (SUPABASE_KEY in atlas/) here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe publishable key (safe for the browser). Set once billing is wired up.
VITE_STRIPE_PUBLISHABLE_KEY=

# Base URL of the backend FastAPI app (for picks data + billing endpoints).
VITE_API_BASE_URL=http://localhost:8000
