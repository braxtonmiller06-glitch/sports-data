# Get a free key at https://api-sports.io (or subscribe to the free tier of
# each product on RapidAPI: American Football, Basketball, Baseball, Football).
# One key works across all products -- 100 requests/day per product on the
# free tier, $10/month upgrades each to 7,500/day.
API_SPORTS_KEY=your_key_here

# Optional: override the SQLAlchemy database URL. Defaults to a local SQLite
# file (sqlite:///./sports_data.db). Point this at Postgres in production,
# e.g. postgresql://user:password@host:5432/sports_data
DATABASE_URL=sqlite:///./sports_data.db

# --- BALLDONTLIE -------------------------------------------------------------
# Key from https://app.balldontlie.io. Tier decides both the rate limit the
# client throttles to and which endpoints answer at all; run
# `python scripts/probe_balldontlie.py` to see exactly what yours reaches.
BALLDONTLIE_API_KEY=your_key_here
BALLDONTLIE_TIER=free

# --- API authentication ------------------------------------------------------
# Supabase project JWT secret (Settings -> API -> JWT Secret). SERVER ONLY --
# never expose this as a VITE_ variable, it verifies every access token.
SUPABASE_JWT_SECRET=

# Leave on. Off makes every data route an open proxy to a metered upstream,
# and the app refuses to start with it off once deployed.
AUTH_REQUIRED=true

# Per-caller limit, separate from the shared upstream daily quota.
RATE_LIMIT_PER_MINUTE=60

# Comma-separated browser origins. Never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave off outside local debugging: on, error bodies quote upstream responses
# and database connection strings.
DEBUG_ERRORS=false
