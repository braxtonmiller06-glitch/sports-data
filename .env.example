# Get a free key at https://api-sports.io (or subscribe to the free tier of
# each product on RapidAPI: American Football, Basketball, Baseball, Football).
# One key works across all products -- 100 requests/day per product on the
# free tier, $10/month upgrades each to 7,500/day.
API_SPORTS_KEY=your_key_here

# Optional: override the SQLAlchemy database URL. Defaults to a local SQLite
# file (sqlite:///./sports_data.db). Point this at Postgres in production,
# e.g. postgresql://user:password@host:5432/sports_data
DATABASE_URL=sqlite:///./sports_data.db
